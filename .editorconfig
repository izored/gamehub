root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Windows PowerShell 5.1 reads BOM-less files as ANSI: keep scripts pure ASCII
[*.{ps1,vbs}]
charset = latin1
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false
